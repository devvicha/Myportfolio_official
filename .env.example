# Browser-visible configuration only. Never put private API keys in VITE_ values.
# AI service origin or complete /api/ask endpoint. Blank enables saved answers.
# Local development example: http://localhost:8080
# Open the frontend at http://localhost:5173/Myportfolio_official/ for backend CORS.
# Production example: https://your-portfolio-agent.example.com
VITE_ASK_API_URL=

# Optional EmailJS browser configuration. Leave blank to use existing portfolio settings.
# Template fields: your_name, your_email, message
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
